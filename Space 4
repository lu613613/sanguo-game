function bindPanel(p){
  Array.prototype.forEach.call(p.querySelectorAll("[data-gen]"), function(el){
    el.addEventListener("click", function(){
      var name = el.getAttribute("data-gen");
      var g = G.generals[name];
      if (ui.mode==="attack" && g && g.city===ui.selCity && g.fac===myFacId()){
        var i = ui.party.indexOf(name);
        if (i>=0) ui.party.splice(i,1);
        else if (ui.party.length<3) ui.party.push(name);
        else { toast("出征最多 3 名武将"); return; }
        render(); return;
      }
      ui.selGen = (ui.selGen===name ? null : name);
      render();
    });
  });
  Array.prototype.forEach.call(p.querySelectorAll("[data-cmd]"), function(el){
    el.addEventListener("click", function(){ onCommand(el.getAttribute("data-cmd")); });
  });
  Array.prototype.forEach.call(p.querySelectorAll("[data-recruit]"), function(el){
    el.addEventListener("click", function(){
      var r = actRecruitPrisoner(G, myFacId(), el.getAttribute("data-recruit"));
      toast(r.msg); if (r.ok) afterAction(); else render();
    });
  });
  var ca = $("pCancelAtk");
  if (ca) ca.onclick = function(){ ui.mode=null; ui.party=[]; render(); };
}
function onCommand(cmd){
  var g = G.generals[ui.selGen];
  if (!g || !isMyTurn()) return;
  var r = null;
  if (cmd==="develop") r = actDevelop(G, g);
  else if (cmd==="search") r = actSearch(G, g);
  else if (cmd==="recruit") r = actRecruit(G, g);
  else if (cmd==="train") r = actTrain(G, g);
  else if (cmd==="move"){ ui.mode="move"; ui.moveGen=g.name; toast("移动模式：点击地图上任意己方城池"); render(); return; }
  else if (cmd==="attack"){
    var hasEnemy = ADJ[g.city].some(function(n){ return G.cities[n].owner!==g.fac; });
    if (!hasEnemy){ toast("相邻没有敌城，无法出征"); return; }
    ui.mode="attack"; ui.selCity=g.city; ui.party=[g.name];
    toast("出征模式：可再点选同城武将加入（≤3名），再点相邻敌城开战");
    render(); return;
  }
  if (r){ toast(r.msg); if (r.ok) afterAction(); else render(); }
}
