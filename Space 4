<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="data:," />
    <title>三国群英对战</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;700;900&display=swap" rel="stylesheet" />
    <style>
      :root{
        --bg:#14102a; --bg2:#1d1740; --panel:#241b4d; --panel2:#2c2160;
        --gold:#c9a227; --gold2:#e8c95a; --ink:#efe8d8; --ink-dim:#b9b0d0;
        --red:#c8452c; --green:#4caf7d; --line:#4a3d85;
        --btn:#3a2c72; --btn-dis:#2a2348;
      }
      *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
      html,body{margin:0;padding:0;}
      body{
        background:radial-gradient(1200px 700px at 50% -10%, #2c2160 0%, var(--bg) 60%);
        color:var(--ink); font-family:"Noto Serif SC","Songti SC",serif;
        min-height:100vh; font-size:15px;
      }
      button{font-family:inherit; cursor:pointer;}
      .hidden{display:none !important;}
      /* ---------- 通用 ---------- */
      .gold-btn{
        background:linear-gradient(180deg,#5a4712,#8a6d1d); color:#fff8e1;
        border:1px solid var(--gold2); border-radius:6px; padding:9px 16px;
        font-size:15px; font-weight:700; letter-spacing:1px;
      }
      .gold-btn:disabled{background:var(--btn-dis); color:#8d84ad; border-color:#554a86; cursor:not-allowed;}
      .plain-btn{
        background:var(--btn); color:var(--ink); border:1px solid var(--line);
        border-radius:6px; padding:8px 14px; font-size:14px; font-weight:700;
      }
      .plain-btn:disabled{background:var(--btn-dis); color:#8d84ad; cursor:not-allowed;}
      .plain-btn.sel{border-color:var(--gold2); color:var(--gold2); box-shadow:0 0 0 1px var(--gold2) inset;}
      .danger-btn{background:#6e2418; color:#ffd9d0; border:1px solid #a34a38; border-radius:6px; padding:8px 14px; font-weight:700;}
      input[type=text],input[type=password]{
        width:100%; background:#171233; color:var(--ink); border:1px solid var(--line);
        border-radius:6px; padding:10px 12px; font-size:15px; font-family:inherit;
      }
      label.flabel{display:block; font-size:13px; color:var(--ink-dim); margin:12px 0 5px;}
      .card{
        background:linear-gradient(180deg,var(--panel2),var(--panel));
        border:1px solid var(--gold); border-radius:10px; padding:18px;
        box-shadow:0 8px 30px rgba(0,0,0,.45);
      }
      /* ---------- 大厅 ---------- */
      #lobby{max-width:860px; margin:0 auto; padding:22px 14px 60px;}
      #lobby h1{font-size:34px; text-align:center; margin:8px 0 2px; color:var(--gold2); letter-spacing:6px; font-weight:900;}
      #lobby .sub{text-align:center; color:var(--ink-dim); font-size:13px; margin-bottom:20px; letter-spacing:2px;}
      .tabs{display:flex; gap:8px; margin-bottom:14px;}
      .tabs button{flex:1; padding:11px; font-size:16px; font-weight:700; background:var(--panel); color:var(--ink-dim); border:1px solid var(--line); border-radius:8px;}
      .tabs button.on{background:var(--panel2); color:var(--gold2); border-color:var(--gold);}
      .scen-grid,.lord-grid{display:flex; flex-wrap:wrap; gap:8px;}
      .scen-grid button,.lord-grid button{
        background:#1b1540; border:1px solid var(--line); color:var(--ink);
        border-radius:8px; padding:10px 12px; font-size:14px; font-weight:700;
      }
      .scen-grid button.on,.lord-grid button.on{border-color:var(--gold2); color:var(--gold2); background:#2c2160;}
      .scen-grid button:disabled,.lord-grid button:disabled{opacity:.38; cursor:not-allowed;}
      .lord-dot{display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; vertical-align:middle;}
      .rowflex{display:flex; gap:10px; flex-wrap:wrap; align-items:center;}
      .rowflex>*{flex:1;}
      .hint{font-size:13px; color:var(--ink-dim); line-height:1.7;}
      .err{color:#ff9c8a; font-size:14px; min-height:20px; margin-top:8px;}
      .bigcode{font-size:42px; letter-spacing:12px; color:var(--gold2); text-align:center; font-weight:900; padding:10px 0;}
      /* ---------- 游戏主界面 ---------- */
      #gameView{display:flex; flex-direction:column; height:100vh; height:100dvh;}
      #topbar{
        display:flex; flex-wrap:wrap; gap:6px 14px; align-items:center;
        background:linear-gradient(180deg,#2c2160,#1d1740); border-bottom:2px solid var(--gold);
        padding:8px 12px; font-size:14px;
      }
      #topbar .tb-title{color:var(--gold2); font-weight:900; letter-spacing:2px;}
      #topbar .tb-turn{color:#ffd970; font-weight:700;}
      #topbar .spacer{flex:1;}
      #topbar .res b{color:var(--gold2);}
      #main{flex:1; display:flex; min-height:0;}
      #mapwrap{flex:1.6; min-width:0; padding:8px; display:flex;}
      #map{width:100%; height:100%; background:radial-gradient(700px 480px at 50% 40%, #241a52, #171233); border:1px solid var(--line); border-radius:10px;}
      #panel{
        flex:1; min-width:290px; max-width:430px; overflow-y:auto; padding:10px;
        border-left:1px solid var(--line); background:rgba(20,16,42,.6);
      }
      #panel h3{margin:4px 0 8px; color:var(--gold2); font-size:17px; letter-spacing:1px;}
      #panel h4{margin:14px 0 6px; color:var(--ink); font-size:14px; border-bottom:1px solid var(--line); padding-bottom:4px;}
      .cityinfo{font-size:13.5px; line-height:1.75; color:var(--ink-dim);}
      .cityinfo b{color:var(--ink);}
      .genrow{
        display:flex; gap:8px; align-items:center; background:#1e1748; border:1px solid var(--line);
        border-radius:8px; padding:7px 8px; margin-bottom:7px; cursor:pointer;
      }
      .genrow.sel{border-color:var(--gold2); box-shadow:0 0 0 1px var(--gold2) inset;}
      .genrow.acted{opacity:.55;}
      .genrow .ginfo{flex:1; min-width:0; font-size:13px; line-height:1.5;}
      .genrow .gname{font-size:15px; font-weight:700;}
      .avatar{
        width:40px; height:40px; border-radius:8px; flex:none; display:flex; align-items:center; justify-content:center;
        font-size:20px; font-weight:900; color:#fff; border:1px solid rgba(255,255,255,.35); text-shadow:0 1px 3px rgba(0,0,0,.7);
      }
      .avatar.sm{width:32px; height:32px; font-size:16px; border-radius:6px;}
      .cmdgrid{display:flex; flex-wrap:wrap; gap:7px; margin-top:6px;}
      .cmdgrid button{flex:1 1 30%;}
      .statgrid{display:grid; grid-template-columns:1fr 1fr; gap:4px 12px; font-size:13.5px;}
      .statgrid span{color:var(--ink-dim);} .statgrid b{color:var(--ink); text-align:right;}
      .bar{height:8px; background:#120d2a; border-radius:4px; overflow:hidden; border:1px solid #3a2f6e;}
      .bar>i{display:block; height:100%;}
      .bar.hp>i{background:#c8452c;} .bar.mp>i{background:#3f7fd1;}
      #logbar{
        height:132px; flex:none; overflow-y:auto; border-top:2px solid var(--gold);
        background:#100b26; padding:7px 12px; font-size:13px; line-height:1.65;
      }
      #logbar .lt{color:#8d84ad; margin-right:6px;}
      #logbar .war{color:#ffb59d;} #logbar .good{color:#9fe6bd;} #logbar .sys{color:#ffe08a;}
      /* ---------- 弹窗 ---------- */
      #modalWrap{position:fixed; inset:0; background:rgba(5,3,16,.75); display:flex; align-items:center; justify-content:center; z-index:50; padding:12px;}
      #modal{background:var(--panel); border:1px solid var(--gold); border-radius:10px; max-width:860px; width:100%; max-height:88vh; overflow-y:auto; padding:16px;}
      #modal h3{margin:0 0 10px; color:var(--gold2);}
      table.gtable{width:100%; border-collapse:collapse; font-size:13px;}
      table.gtable th,table.gtable td{border-bottom:1px solid var(--line); padding:5px 6px; text-align:left; white-space:nowrap;}
      table.gtable th{color:var(--gold2);}
      .tablewrap{overflow-x:auto;}
      /* ---------- toast ---------- */
      #toast{
        position:fixed; left:50%; bottom:150px; transform:translateX(-50%) translateY(20px);
        background:#0e0a24; border:1px solid var(--gold2); color:var(--ink); padding:10px 18px;
        border-radius:8px; font-size:14px; opacity:0; pointer-events:none; transition:.25s; z-index:99; max-width:88vw; text-align:center;
      }
      #toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
      .wait-banner{background:#3d3410; border:1px solid var(--gold); color:#ffe08a; border-radius:8px; padding:10px 12px; font-size:14px; margin-bottom:10px; line-height:1.6;}
      .prison-row{display:flex; gap:8px; align-items:center; background:#2a1440; border:1px solid #6b3fa0; border-radius:8px; padding:7px 8px; margin-bottom:7px; font-size:13.5px;}
      @media (max-width:820px){
        #main{flex-direction:column;}
        #mapwrap{flex:none; height:47vh;}
        #panel{max-width:none; min-width:0; border-left:none; border-top:1px solid var(--line); flex:1;}
        #logbar{height:104px;}
        #lobby h1{font-size:27px;}
        #toast{bottom:118px;}
      }
    </style>
  </head>
  <body>
    <!-- ================= 大厅 ================= -->
    <div id="lobby">
      <h1>三国群英对战</h1>
      <div class="sub">内 政 · 征 兵 · 搜 索 · 攻 城 · 招 降 — 照原版玩法重做的双人对战</div>

      <div class="tabs">
        <button id="tabSingle" class="on">单人模式</button>
        <button id="tabOnline">联机对战</button>
      </div>

      <!-- 单人 -->
      <div id="paneSingle" class="card">
        <h3 style="margin-top:0;color:var(--gold2)">选择剧本</h3>
        <div class="scen-grid" id="singleScen"></div>
        <h3 style="color:var(--gold2)">选择你的君主</h3>
        <div class="lord-grid" id="singleLord"></div>
        <p class="hint">单人模式纯本地进行：你选一位君主，其余君主全部由电脑 AI 控制。每季你行动后，AI 君主依次行动并结算。</p>
        <div class="rowflex" style="margin-top:10px">
          <button class="gold-btn" id="btnStartSingle">开始游戏</button>
        </div>
        <div class="err" id="singleErr"></div>
      </div>

      <!-- 联机 -->
      <div id="paneOnline" class="card hidden">
        <!-- 配置 -->
        <div id="cfgBox">
          <h3 style="margin-top:0;color:var(--gold2)">联机配置（首次使用）</h3>
          <p class="hint">联机通过你自己的 Supabase 项目同步对局。填入项目地址与 publishable key，验证通过后保存在本机浏览器，之后自动读取。朋友要填<b>同一个</b>项目的地址和 key 才能进同一房间。</p>
          <label class="flabel">项目地址 Project URL</label>
          <input type="text" id="cfgUrl" placeholder="https://xxxxx.supabase.co" autocomplete="off" />
          <label class="flabel">Publishable key（或 anon key）</label>
          <input type="text" id="cfgKey" placeholder="粘贴以 sb_publishable_ 开头的 key" autocomplete="off" />
          <div class="rowflex" style="margin-top:14px">
            <button class="gold-btn" id="btnSaveCfg">验证并保存</button>
          </div>
          <div class="err" id="cfgErr"></div>
          <details style="margin-top:8px">
            <summary class="hint" style="cursor:pointer">第一次使用？先在 Supabase 项目里建一张表（只需一次）</summary>
            <pre style="white-space:pre-wrap;font-size:12px;background:#171233;padding:10px;border-radius:6px;border:1px solid var(--line)">create table if not exists game_rooms (
  code text primary key,
  state jsonb not null,
  updated_at timestamptz default now()
);
alter table game_rooms enable row level security;
create policy "anyone can read" on game_rooms for select using (true);
create policy "anyone can insert" on game_rooms for insert with check (true);
create policy "anyone can update" on game_rooms for update using (true) with check (true);
create policy "anyone can delete" on game_rooms for delete using (true);</pre>
          </details>
        </div>
        <!-- 房间 -->
        <div id="roomBox" class="hidden">
          <h3 style="margin-top:0;color:var(--gold2)">创建房间</h3>
          <div class="scen-grid" id="onlineScen"></div>
          <h3 style="color:var(--gold2)">选择你的君主（房主）</h3>
          <div class="lord-grid" id="onlineLord"></div>
          <div class="rowflex" style="margin-top:12px">
            <button class="gold-btn" id="btnCreate">创建房间</button>
          </div>
          <div class="err" id="createErr"></div>
          <h3 style="color:var(--gold2);margin-top:22px">加入房间</h3>
          <div class="rowflex">
            <input type="text" id="joinCode" placeholder="输入 4 位房间号" maxlength="4" style="flex:1" autocomplete="off" />
            <button class="plain-btn" id="btnFindRoom" style="flex:0 0 auto">查找房间</button>
          </div>
          <div id="joinBox" class="hidden" style="margin-top:12px">
            <p class="hint" id="joinInfo"></p>
            <h4 style="color:var(--gold2);margin:8px 0">选择你的君主（挑战者）</h4>
            <div class="lord-grid" id="joinLord"></div>
            <div class="rowflex" style="margin-top:12px">
              <button class="gold-btn" id="btnJoin">加入并开始</button>
            </div>
          </div>
          <div class="err" id="joinErr"></div>
          <div class="rowflex" style="margin-top:20px">
            <button class="plain-btn" id="btnResetCfg">重置联机配置</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= 游戏 ================= -->
    <div id="gameView" class="hidden">
      <div id="topbar"></div>
      <div id="main">
        <div id="mapwrap"><svg id="map" viewBox="0 0 900 700" preserveAspectRatio="xMidYMid meet"></svg></div>
        <aside id="panel"></aside>
      </div>
      <div id="logbar"></div>
    </div>

    <div id="modalWrap" class="hidden"><div id="modal"></div></div>
    <div id="toast"></div>

