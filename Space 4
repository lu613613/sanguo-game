var SEASONS = ["春","夏","秋","冬"];
function hashStr(s){ var h=0; for (var i=0;i<s.length;i++){ h=(h*31 + s.charCodeAt(i))|0; } return Math.abs(h); }
function makeGeneral(name, facId, city, isLord){
  var d = GEN[name] || [60,50,"步兵"];
  var lv = isLord ? 9 : Math.max(3, Math.min(10, 3 + Math.round((d[0]+d[1]-60)/18)));
  var g = {
    name:name, fac:facId, city:city, wild:false, prisoner:false, heldBy:null, prisonSeason:-1,
    wu:d[0], zhi:d[1], troop:d[2], lv:lv, exp:0,
    loyal: isLord ? 100 : 72 + (hashStr(name) % 24),
    train:55, acted:false, item:null
  };
  g.maxhp = 100 + lv*6; g.hp = g.maxhp;
  g.maxmp = 30 + Math.round(d[1]/2); g.mp = g.maxmp;
  g.soldiers = Math.round(soldierCap(g)*0.72/10)*10;
  return g;
}
function newGameState(scenId, mode){
  var scen = scenById(scenId);
  var st = {
    v:1, mode:mode, scen:scenId, phase:"waiting", /* waiting | playing | over */
    year:scen.year, season:0, turn:"A", humans:{A:null, B:null},
    factions:{}, cities:{}, generals:{}, log:[], winner:null, _ts:Date.now()
  };
  scen.factions.forEach(function(f){
    st.factions[f.id] = {
      id:f.id, lord:f.lord, color:f.color, aiOnly:!!f.aiOnly,
      gold:2000, grain:3000, human:null, alive:true, aiActed:false, recruited:false
    };
    Object.keys(f.cities).forEach(function(cn){
      st.cities[cn] = { name:cn, owner:f.id, pop:CITIES[cn].pop, dev:45 + (hashStr(cn)%20), def:CITIES[cn].def };
      f.cities[cn].forEach(function(gn){
        st.generals[gn] = makeGeneral(gn, f.id, cn, gn===f.lord);
      });
    });
  });
  Object.keys(scen.wild||{}).forEach(function(cn){
    scen.wild[cn].forEach(function(gn){
      var g = makeGeneral(gn, null, cn, false);
      g.wild = true; g.soldiers = Math.round(soldierCap(g)*0.4/10)*10;
      st.generals[gn] = g;
    });
  });
  pushLog(st, "sys", "「" + scen.name + "」开局：" + scen.desc + "。天下大势，分久必合。");
