}
/* ---------------- 状态查询工具 ---------------- */
function F(st, fid){ return st.factions[fid]; }
function facGens(st, fid){
  return Object.keys(st.generals).map(function(k){return st.generals[k];})
    .filter(function(g){ return g.fac===fid && !g.wild && !g.prisoner; });
}
function cityGens(st, cn){
  return Object.keys(st.generals).map(function(k){return st.generals[k];})
    .filter(function(g){ return g.city===cn && !g.wild && !g.prisoner; });
}
function cityWilds(st, cn){
  return Object.keys(st.generals).map(function(k){return st.generals[k];})
    .filter(function(g){ return g.city===cn && g.wild; });
}
function facCities(st, fid){
  return CITY_NAMES.filter(function(cn){ return st.cities[cn].owner===fid; });
}
function facTotalSoldiers(st, fid){
  return facGens(st, fid).reduce(function(s,g){ return s+g.soldiers; }, 0);
}
function prisonersOf(st, fid){
  return Object.keys(st.generals).map(function(k){return st.generals[k];})
    .filter(function(g){ return g.prisoner && g.heldBy===fid; });
}
function pushLog(st, cls, text){
  st.log.push({t: st.year + "年" + SEASONS[st.season], cls:cls, text:text});
  if (st.log.length > 120) st.log.splice(0, st.log.length-120);
}
function lordCity(st, fid){
  var lg = st.generals[F(st,fid).lord];
  if (lg && !lg.prisoner && lg.city) return lg.city;
  var cs = facCities(st, fid);
  return cs.length ? cs[0] : null;
}
function nearestOwnCity(st, fid, from){
  if (!from) return lordCity(st, fid);
  var seen = {}, q = [[from,0]];
  seen[from]=true;
  while (q.length){
    var cur = q.shift();
    if (st.cities[cur[0]].owner===fid && cur[0]!==from) return cur[0];
    ADJ[cur[0]].forEach(function(n){ if(!seen[n]){ seen[n]=true; q.push([n, cur[1]+1]); } });
  }
  var cs = facCities(st, fid);
  return cs.length ? cs[0] : null;
}
function checkElimination(st){
  Object.keys(st.factions).forEach(function(fid){
    var f = st.factions[fid];
    if (f.alive && facCities(st, fid).length===0){
      f.alive = false;
      facGens(st, fid).forEach(function(g){ g.wild = true; g.fac = null; });
      prisonersOf(st, fid).forEach(function(g){ g.prisoner=false; g.heldBy=null; g.wild=true; g.fac=null; g.city = lordCity(st,fid) || g.city; });
      pushLog(st, "war", "【灭亡】" + f.lord + " 势力覆灭，其部将四散为在野。");
      if (f.human){
        st.phase = "over";
        st.winner = f.human==="A" ? "B" : "A";
        pushLog(st, "sys", "玩家势力被灭，本局结束。");
      }
    }
  });
  if (st.phase!=="over"){
    var alive = Object.keys(st.factions).filter(function(fid){ return st.factions[fid].alive; });
    var total = CITY_NAMES.length;
    for (var i=0;i<alive.length;i++){
      if (facCities(st, alive[i]).length===total){
        st.phase = "over";
        var f2 = st.factions[alive[i]];
        st.winner = f2.human || "AI";
        pushLog(st, "sys", "【天下统一】" + f2.lord + " 席卷天下，一统江山！");
        break;
      }
    }
  }
}

/* ============================================================
