   ============================================================ */
function advisorBonus(st, fid){
  var best = 0;
  facGens(st, fid).forEach(function(g){ if (g.zhi > best) best = g.zhi; });
  return best >= 95 ? 1.05 : 1;
}
function strikeDamage(st, atk, def, mult){
  var base = atk.soldiers * 0.055 * (0.5 + atk.wu/100) * troopMult(atk.troop, def.troop)
    * (0.55 + atk.train/100*0.9) * (0.9 + Math.random()*0.2);
  return Math.max(4, Math.round(base * (mult||1) * advisorBonus(st, atk.fac)));
}
function trySkill(st, atk, def, blog, sideName){
  var list = skillsOf(atk);
  if (!list.length || Math.random() > 0.62) return 0;
  /* 命疗术：残血优先 */
  for (var i=0;i<list.length;i++){
    var s = list[i];
    if (s.heal && atk.mp >= s.cost && (atk.hp < atk.maxhp*0.6 || atk.soldiers < soldierCap(atk)*0.45)){
      atk.mp -= s.cost;
      var healS = Math.round(atk.soldiers*0.15) + 60, healH = Math.round(atk.maxhp*0.18);
      atk.soldiers += healS; atk.hp = Math.min(atk.maxhp, atk.hp + healH);
      blog.push("✦ " + atk.name + " 施展武将技【命疗术】，回复兵力 " + healS + "、体力 " + healH + "。");
      return -1;
    }
  }
  var dmg = list.filter(function(s){ return !s.heal && atk.mp >= s.cost; })
                .sort(function(a,b){ return b.mult - a.mult; })[0];
  if (!dmg) return 0;
  atk.mp -= dmg.cost;
  var d = strikeDamage(st, atk, def, dmg.mult);
  blog.push("✦ " + atk.name + " 施展武将技【" + dmg.name + "】，对 " + def.name + " 造成 " + d + " 点杀伤！");
  return d;
}
function gainExp(st, g, n, blog){
  g.exp += n;
  while (g.exp >= g.lv*80 && g.lv < 20){
    g.exp -= g.lv*80; g.lv++;
    if (g.lv % 2 === 0) g.wu = Math.min(105, g.wu+1); else g.zhi = Math.min(105, g.zhi+1);
    g.maxhp += 8; g.maxmp += 3; g.hp = Math.min(g.maxhp, g.hp + Math.round(g.maxhp*0.3));
    blog.push("★ " + g.name + " 升至 " + g.lv + " 级！带兵上限提升至 " + soldierCap(g) + "。");
  }
}
function resolveBattle(st, atkFid, fromCity, atkNames, targetName){
  var tf = st.cities[targetName], defFid = tf.owner;
  var atkF = F(st, atkFid), defF = F(st, defFid);
  var blog = [];
  var attackers = atkNames.map(function(n){ return st.generals[n]; }).filter(Boolean);
  var defAll = cityGens(st, targetName).sort(function(a,b){ return genPower(b)-genPower(a); });
  var defenders = defAll.slice(0,3), extras = defAll.slice(3);
  var wall = tf.def*8 + extras.length*150;
  blog.push("⚔ " + atkF.lord + "方自 " + fromCity + " 出兵攻打 " + defF.lord + " 的 " + targetName +
    "（攻方 " + attackers.map(function(g){return g.name;}).join("、") + "；守方 " +
    (defenders.length ? defenders.map(function(g){return g.name;}).join("、") : "无将守城") + "，城防 " + wall + "）。");
  attackers.forEach(function(g){ g.acted = true; });
  var defeatedDef = [], defeatedAtk = [];
  var ai = 0, di = 0, round = 0;
  while (ai < attackers.length && di < defenders.length && round < 90){
    round++;
    var A = attackers[ai], D = defenders[di];
    A.mp = Math.min(A.maxmp, A.mp + 3); D.mp = Math.min(D.maxmp, D.mp + 3);
    /* 攻方技能与攻击 */
    var sk = trySkill(st, A, D, blog, "攻");
    var dmgA = sk === -1 ? 0 : (sk > 0 ? sk : strikeDamage(st, A, D, 1));
    if (dmgA > 0){
      if (wall > 0){
        var absorbed = Math.min(wall, dmgA);
        wall -= absorbed; dmgA -= absorbed;
        if (absorbed > 0) blog.push("第" + round + "合：" + A.name + " 攻击城防，城防 -" + absorbed + "（余 " + wall + "）。");
      }
      if (dmgA > 0){
        var before = D.soldiers;
        D.soldiers = Math.max(0, D.soldiers - dmgA);
        D.hp -= Math.round(dmgA/Math.max(1,before)*55);
        blog.push("第" + round + "合：" + A.name + "（" + A.troop + " " + A.soldiers + "）攻 " + D.name + "，杀伤 " + dmgA + "，其余兵 " + D.soldiers + "。");
      }
    }
    if (D.soldiers <= 0 || D.hp <= 0){
      if (D.soldiers > 0) D.soldiers = Math.round(D.soldiers*0.4);
      defeatedDef.push(D); blog.push("✝ " + D.name + " 败退！"); di++; continue;
    }
    /* 守方技能与反击 */
    var sk2 = trySkill(st, D, A, blog, "守");
    var dmgD = sk2 === -1 ? 0 : (sk2 > 0 ? sk2 : strikeDamage(st, D, A, 1));
    if (dmgD > 0){
      var beforeA = A.soldiers;
      A.soldiers = Math.max(0, A.soldiers - dmgD);
      A.hp -= Math.round(dmgD/Math.max(1,beforeA)*55);
      blog.push("第" + round + "合：" + D.name + " 反击 " + A.name + "，杀伤 " + dmgD + "，其余兵 " + A.soldiers + "。");
    }
    if (A.soldiers <= 0 || A.hp <= 0){
      if (A.soldiers > 0) A.soldiers = Math.round(A.soldiers*0.4);
      defeatedAtk.push(A); blog.push("✝ 攻方 " + A.name + " 败退！"); ai++;
    }
  }
  var atkWin = di >= defenders.length;
  if (defenders.length === 0) atkWin = true;
  /* 经验 */
  attackers.forEach(function(g){ gainExp(st, g, atkWin ? 55 : 22, blog); });
  defenders.forEach(function(g){ gainExp(st, g, atkWin ? 20 : 50, blog); });
  if (atkWin){
    /* 守方败将被俘判定 */
    defeatedDef.forEach(function(g){
      var isLord = (g.name === defF.lord);
      if (!isLord && Math.random() < 0.45){
        g.prisoner = true; g.heldBy = atkFid; g.prisonSeason = st.year*4 + st.season;
        g.city = targetName; g.hp = Math.round(g.maxhp*0.4); g.soldiers = Math.max(60, Math.round(g.soldiers*0.3));
        g.fac = defFid;
        blog.push("⛓ " + g.name + " 力战被俘，已押入 " + atkF.lord + " 监牢（下季起可招降）。");
      } else {
        var esc = nearestOwnCity(st, defFid, targetName);
        g.soldiers = Math.max(50, Math.round(g.soldiers*0.25)); g.hp = Math.round(g.maxhp*0.4);
        if (esc){ g.city = esc; blog.push("☰ " + g.name + " 突围而走，退往 " + esc + "。"); }
        else { g.wild = true; g.fac = null; g.city = targetName; blog.push("☰ " + g.name + " 无路可退，遁入民间（在野）。"); }
      }
    });
    /* 未上场守将撤退 */
    extras.forEach(function(g){
      if (g.prisoner) return;
      var esc = nearestOwnCity(st, defFid, targetName);
      if (esc) g.city = esc; else { g.wild = true; g.fac = null; g.city = targetName; }
    });
    /* 无将守城的残部 */
    tf.owner = atkFid;
    tf.pop = Math.round(tf.pop*0.9); tf.dev = Math.max(5, tf.dev - 10);
    /* 攻方入驻：城内将领上限 5 */
    var aliveAtk = attackers.filter(function(g){ return defeatedAtk.indexOf(g) < 0; });
    var roomLeft = 5;
    aliveAtk.forEach(function(g){
      if (roomLeft > 0){ g.city = targetName; roomLeft--; }
      else { g.city = fromCity; blog.push("☰ " + targetName + " 驻将已满，" + g.name + " 留驻 " + fromCity + "。"); }
    });
    defeatedAtk.forEach(function(g){
      g.city = fromCity; g.hp = Math.max(1, Math.round(g.maxhp*0.4));
      g.soldiers = Math.max(50, g.soldiers);
    });
    blog.push("🏯 " + atkF.lord + " 攻克 " + targetName + "！城池易主。");
  } else {
    defeatedAtk.forEach(function(g){
      g.city = fromCity; g.hp = Math.max(1, Math.round(g.maxhp*0.4)); g.soldiers = Math.max(50, g.soldiers);
    });
    attackers.forEach(function(g){ if (defeatedAtk.indexOf(g)<0) g.city = fromCity; });
    defeatedDef.forEach(function(g){ g.hp = Math.max(1, Math.round(g.maxhp*0.35)); });
    if (wall >= 0) tf.def = Math.max(20, tf.def - 2);
    blog.push("🛡 " + defF.lord + " 守住 " + targetName + "，攻方退回 " + fromCity + "。");
  }
  blog.forEach(function(line){ pushLog(st, "war", line); });
  checkElimination(st);
  return {win: atkWin, log: blog};
}

/* ============================================================
   季节结算：产出 / 耗粮 / 恢复 / 进入下一季
   ============================================================ */
function settleSeason(st){
  Object.keys(st.factions).forEach(function(fid){
    var f = st.factions[fid];
    if (!f.alive) return;
    var gIn = 0, grIn = 0;
    facCities(st, fid).forEach(function(cn){
      var c = st.cities[cn];
      gIn += Math.round(c.pop/1000 * (5 + c.dev/5));
      grIn += Math.round(c.pop/1000 * (8 + c.dev/4));
      c.pop = Math.round(c.pop * (1 + c.dev/2000));
    });
    f.gold += gIn; f.grain += grIn;
    var upkeep = Math.floor(facTotalSoldiers(st, fid)/100);
    f.grain -= upkeep;
    var note = f.lord + " 结算：+" + gIn + " 金、+" + grIn + " 粮，军粮耗 " + upkeep + "。";
    if (f.grain < 0){
      var ratio = Math.min(0.5, Math.abs(f.grain)/Math.max(1,upkeep)/2 + 0.1);
      facGens(st, fid).forEach(function(g){
        var lost = Math.round(g.soldiers * ratio);
        g.soldiers -= lost;
      });
      f.grain = 0;
      note += " ⚠ 粮草告罄！全军出现逃兵（约 " + Math.round(ratio*100) + "%）。";
      pushLog(st, "war", "【缺粮】" + note);
    } else {
      pushLog(st, "", "【结算】" + note);
    }
    /* 武将恢复 */
    facGens(st, fid).forEach(function(g){
      g.acted = false;
      g.hp = Math.min(g.maxhp, g.hp + Math.round(g.maxhp*0.4));
      g.mp = g.maxmp;
    });
    prisonersOf(st, fid).forEach(function(g){ g.hp = Math.min(g.maxhp, g.hp + 10); });
    f.aiActed = false; f.recruited = false;
  });
  st.season++;
  if (st.season > 3){ st.season = 0; st.year++; }
  pushLog(st, "sys", "—— 进入 " + st.year + " 年 " + SEASONS[st.season] + " ——");
  checkElimination(st);
}

/* ============================================================
   AI 君主：开发 / 征兵 / 训练 / 出征 / 招降
   ============================================================ */
function aiActFaction(st, fid){
  var f = st.factions[fid];
  if (!f.alive || f.aiActed) return;
  f.aiActed = true;
  /* 招降俘虏（自动判定） */
  var prs = prisonersOf(st, fid).filter(function(g){ return g.prisonSeason < st.year*4 + st.season; });
  if (prs.length && !f.recruited){
    var r = actRecruitPrisoner(st, fid, prs[0].name);
    if (!r.ok) f.recruited = false;
  }
  var gens = facGens(st, fid).filter(function(g){ return !g.acted; });
  /* 最弱城优先开发 */
  var cities = facCities(st, fid).slice().sort(function(a,b){ return st.cities[a].dev - st.cities[b].dev; });
  var weakest = cities[0];
  gens.sort(function(a,b){ return genPower(b) - genPower(a); });
  gens.forEach(function(g, idx){
    if (g.acted) return;
    var cap = soldierCap(g);
    if (idx === 0 && g.soldiers < cap*0.8 && f.gold > 300 && st.cities[g.city].pop > 3000){
      actRecruit(st, g);
    } else if (g.city === weakest && st.cities[g.city].dev < 85 && f.gold > 200){
      actDevelop(st, g);
    } else if (g.train < 65){
      if (f.gold > 60) actTrain(st, g); else g.acted = true;
    } else if (g.soldiers < cap*0.9 && f.gold > 250){
      actRecruit(st, g);
    } else if (f.gold > 200){
      actDevelop(st, g);
    } else {
      g.acted = true;
    }
  });
  /* 出征判定：某城可用兵力 > 相邻敌城守备 1.3 倍则攻其最弱 */
  var myCities = facCities(st, fid);
  for (var ci=0; ci<myCities.length; ci++){
    var cn = myCities[ci];
    var avail = cityGens(st, cn).filter(function(g){ return !g.acted && g.soldiers > 150; })
                                .sort(function(a,b){ return genPower(b)-genPower(a); }).slice(0,3);
    if (!avail.length) continue;
    var myPow = avail.reduce(function(s,g){ return s + genPower(g); }, 0);
    var targets = ADJ[cn].filter(function(n){ return st.cities[n].owner !== fid; });
    var best = null, bestDef = Infinity;
    targets.forEach(function(tn){
      var defs = cityGens(st, tn).sort(function(a,b){ return genPower(b)-genPower(a); }).slice(0,3);
      var dp = defs.reduce(function(s,g){ return s + genPower(g); }, 0) + st.cities[tn].def*8*3.2;
      if (dp < bestDef){ bestDef = dp; best = tn; }
    });
    if (best && myPow > bestDef * 1.3){
      resolveBattle(st, fid, cn, avail.map(function(g){ return g.name; }), best);
      break;
    }
  }
}
function runAllAI(st){
  Object.keys(st.factions).forEach(function(fid){
    var f = st.factions[fid];
    if (f.alive && !f.human) aiActFaction(st, fid);
  });
}
/* 结束回合：结算 AI → （双人都行动完）季节结算 */
function endTurn(st){
  runAllAI(st);
  if (st.mode === "online" && st.turn === "A" && st.humans.B){
    st.turn = "B";
    pushLog(st, "sys", "—— 轮到玩家二行动 ——");
  } else {
    settleSeason(st);
    st.turn = "A";
  }
  st._ts = Date.now();
}

