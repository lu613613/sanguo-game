};
/* 标签页切换 */
$("tabSingle").onclick = function(){ $("tabSingle").className="on"; $("tabOnline").className=""; $("paneSingle").classList.remove("hidden"); $("paneOnline").classList.add("hidden"); };
$("tabOnline").onclick = function(){ $("tabOnline").className="on"; $("tabSingle").className=""; $("paneOnline").classList.remove("hidden"); $("paneSingle").classList.add("hidden"); refreshCfgUI(); };
/* 断线恢复 */
async function tryResume(){
  var s = null;
  try{ s = JSON.parse(localStorage.getItem("sgq_session") || "null"); }catch(e){}
  if (!s || !s.code || !net.url) return;
  try{
    var row = await fetchRoom(s.code);
    if (!row) return;
    G = row.state; net.code = s.code; net.role = s.role; net.lastTs = G._ts;
    enterGame(); startPoll();
    toast("已恢复之前的对局（房间 " + s.code + "）");
  }catch(e){}
}
/* 启动 */
loadCfg();
refreshLobby();
refreshCfgUI();
if (!net.url){
  /* 首次打开（尚无联机配置）：先呈现联机配置页 */
  $("tabOnline").className = "on"; $("tabSingle").className = "";
  $("paneOnline").classList.remove("hidden"); $("paneSingle").classList.add("hidden");
  refreshCfgUI();
}
tryResume();
</script>
</body>
</html>



