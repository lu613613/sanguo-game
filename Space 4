/* ============================================================
   联机（Supabase REST，配置由玩家自填，代码内无真实地址/key）
   ============================================================ */
function sbHeaders(extra){
  var h = { "apikey": net.key, "Authorization": "Bearer " + net.key, "Content-Type": "application/json" };
  if (extra) for (var k in extra) h[k]=extra[k];
  return h;
}
async function sbFetch(path, opts){
  opts = opts || {};
  var res = await fetch(net.url + "/rest/v1/game_rooms" + path, {
    method: opts.method || "GET", headers: sbHeaders(opts.headers), body: opts.body ? JSON.stringify(opts.body) : undefined
  });
  if (!res.ok) throw new Error("HTTP " + res.status);
  var txt = await res.text();
  return txt ? JSON.parse(txt) : null;
}
async function fetchRoom(code){
  var rows = await sbFetch("?code=eq." + encodeURIComponent(code) + "&select=*");
  return rows && rows.length ? rows[0] : null;
}
async function pushState(){
  if (!G || G.mode!=="online" || !net.code) return;
  try{
    await sbFetch("?code=eq." + encodeURIComponent(net.code), {
      method:"PATCH", headers:{ "Prefer":"return=minimal" },
      body:{ state:G, updated_at:new Date().toISOString() }
    });
    net.lastTs = G._ts;
  }catch(e){ toast("同步失败，请检查网络"); }
}
function startPoll(){
  stopPoll();
  net.timer = setInterval(async function(){
    if (!net.code) return;
    try{
      var row = await fetchRoom(net.code);
      if (!row) return;
      var st = row.state;
      if (st && st._ts !== net.lastTs){
        net.lastTs = st._ts; G = st;
        if (G.phase==="playing") showGame();
        render();
      }
    }catch(e){ /* 轮询失败静默重试 */ }
  }, 1500);
}
function stopPoll(){ if (net.timer){ clearInterval(net.timer); net.timer=null; } }

