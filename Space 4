var G = null;                 /* 当前对局状态 */
var ui = { selCity:null, selGen:null, mode:null, party:[], moveGen:null };
var net = { url:"", key:"", code:"", role:"", lastTs:0, timer:null, joinScen:null, joinState:null };
var lobbySel = { singleScen:"s190", singleLord:null, onlineScen:"s190", onlineLord:null, joinLord:null };

function $(id){ return document.getElementById(id); }
function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;"); }
var toastTimer = null;
function toast(msg){
  var t = $("toast"); t.textContent = msg; t.className = "show";
  clearTimeout(toastTimer); toastTimer = setTimeout(function(){ t.className = ""; }, 2600);
}
function myRole(){ return G && G.mode==="single" ? "A" : net.role; }
function myFacId(){
  if (!G) return null;
  var r = myRole(); return r ? G.humans[r] : null;
}
function isMyTurn(){
  if (!G || G.phase!=="playing") return false;
  if (G.mode==="single") return true;
  return G.turn === net.role;
}
function afterAction(){
  if (!G) return;
  G._ts = Date.now();
  if (G.mode === "online") pushState();
  render();
}
function facColor(fid){ return G && G.factions[fid] ? G.factions[fid].color : "#555"; }
function facName(fid){ return G && G.factions[fid] ? G.factions[fid].lord : "—"; }

/* ---------------- 顶栏 ---------------- */
function renderTopbar(){
  var tb = $("topbar");
  if (!G){ tb.innerHTML = ""; return; }
  var mf = myFacId() ? G.factions[myFacId()] : null;
  var turnTxt = G.phase==="over" ? "对局结束"
    : G.phase==="waiting" ? "等待对手加入…"
    : G.mode==="single" ? "你的回合"
    : (G.turn===net.role ? "你的回合" : "等待对方行动…");
  var html = "<span class='tb-title'>" + esc(scenById(G.scen).name) + "</span>"
    + "<span>" + G.year + " 年 · " + SEASONS[G.season] + "</span>"
    + "<span class='tb-turn'>" + turnTxt + "</span>";
  if (mf){
    html += "<span class='res'>君主 <b>" + esc(mf.lord) + "</b></span>"
      + "<span class='res'>金 <b>" + mf.gold + "</b></span>"
      + "<span class='res'>粮 <b>" + mf.grain + "</b></span>"
      + "<span class='res'>城 <b>" + facCities(G, mf.id).length + "</b></span>"
      + "<span class='res'>将 <b>" + facGens(G, mf.id).length + "</b></span>";
  }
  if (G.mode==="online") html += "<span class='res'>房间 <b>" + esc(net.code) + "</b>（" + (net.role==="A"?"房主":"挑战者") + "）</span>";
  html += "<span class='spacer'></span>"
    + "<button class='plain-btn' id='tbAll'>武将资料</button>"
    + "<button class='gold-btn' id='tbEnd'>结束回合</button>"
    + "<button class='plain-btn' id='tbLeave'>离开对局</button>";
  tb.innerHTML = html;
  $("tbAll").onclick = showAllGenerals;
  $("tbEnd").disabled = !isMyTurn();
  $("tbEnd").onclick = function(){
    if (!isMyTurn()) return;
    ui.mode = null; ui.party = [];
    endTurn(G);
    toast(G.mode==="online" && G.turn==="B" ? "已结束回合，AI 已行动，等待对方" : "季节结算完成，进入 " + G.year + " 年 " + SEASONS[G.season]);
    afterAction();
  };
  $("tbLeave").onclick = leaveGame;
}
/* ---------------- 地图 ---------------- */
function renderMap(){
  var svg = $("map");
  if (!G){ svg.innerHTML=""; return; }
  var s = "";
  LINKS.forEach(function(p){
    var a = CITIES[p[0]], b = CITIES[p[1]];
    s += "<line x1='"+a.x+"' y1='"+a.y+"' x2='"+b.x+"' y2='"+b.y+"' stroke='#5a4d9e' stroke-width='1.6' stroke-dasharray='5 4' opacity='0.75'/>";
  });
  CITY_NAMES.forEach(function(cn){
    var c = G.cities[cn], d = CITIES[cn], col = facColor(c.owner);
    var gens = cityGens(G, cn).length;
    var sel = ui.selCity===cn;
    var hl = "";
    if (ui.mode==="move" && c.owner===myFacId()) hl = "stroke:#7dffb0;stroke-width:3;";
    if (ui.mode==="attack" && ui.selCity && ADJ[ui.selCity].indexOf(cn)>=0 && c.owner!==myFacId()) hl = "stroke:#ff8a70;stroke-width:3;";
    s += "<g data-city='"+cn+"' style='cursor:pointer'>"
      + "<circle cx='"+d.x+"' cy='"+d.y+"' r='"+(sel?19:15)+"' fill='"+col+"' stroke='"+(sel?"#ffd94d":"#e8c95a")+"' stroke-width='"+(sel?3.4:1.6)+"' style='"+hl+"'/>"
      + "<text x='"+d.x+"' y='"+(d.y+5)+"' text-anchor='middle' font-size='13' font-weight='900' fill='#fff' style='pointer-events:none;text-shadow:0 1px 2px #000'>" + cn.charAt(0) + "</text>"
      + "<text x='"+d.x+"' y='"+(d.y+32)+"' text-anchor='middle' font-size='12.5' fill='#efe8d8' style='pointer-events:none'>" + cn + (gens?(" ·"+gens+"将"):"") + "</text>"
      + "</g>";
  });
  svg.innerHTML = s;
  Array.prototype.forEach.call(svg.querySelectorAll("g[data-city]"), function(el){
    el.addEventListener("click", function(){ onCityClick(el.getAttribute("data-city")); });
  });
}
function onCityClick(cn){
  if (!G) return;
  if (ui.mode==="move" && ui.moveGen){
    var g = G.generals[ui.moveGen];
    if (g && isMyTurn() && G.cities[cn].owner===g.fac){
      var r = actMove(G, g, cn);
      toast(r.msg); ui.mode = null; ui.moveGen = null; ui.selCity = cn;
      if (r.ok) afterAction(); else render();
    } else { toast("只能移动到己方城池"); }
    return;
  }
  if (ui.mode==="attack" && ui.selCity){
    var from = ui.selCity;
    if (ADJ[from].indexOf(cn)>=0 && G.cities[cn].owner!==myFacId()){
      doAttack(from, cn); return;
    }
    toast("请选择与 " + from + " 相邻的敌城");
    return;
  }
  ui.selCity = cn;
  if (!ui.selGen || G.generals[ui.selGen].city !== cn) ui.selGen = null;
  render();
}
function doAttack(from, target){
  if (!ui.party.length){ toast("先在出发城勾选出征武将"); return; }
  var names = ui.party.slice();
  ui.mode = null; ui.party = [];
  var r = resolveBattle(G, myFacId(), from, names, target);
  toast(r.win ? "攻克 " + target + "！" : "进攻 " + target + " 被击退");
  ui.selCity = target;
  afterAction();
}
