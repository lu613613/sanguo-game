function actDevelop(st, g){
  var f = F(st, g.fac), c = st.cities[g.city];
  if (f.gold < 100) return {ok:false, msg:"金钱不足（需 100）"};
  f.gold -= 100;
  var gain = 4 + Math.round(g.zhi/9);
  c.dev = Math.min(100, c.dev + gain);
  g.acted = true;
  pushLog(st, "", f.lord + "方：" + g.name + " 在 " + c.name + " 主持开发，开发度 +" + gain + "（现 " + c.dev + "）。");
  return {ok:true, msg:g.name + " 开发 " + c.name + "，开发度 +" + gain};
}
function actSearch(st, g){
  var f = F(st, g.fac), c = st.cities[g.city];
  g.acted = true;
  var rnd = Math.random();
  var wilds = cityWilds(st, c.name).filter(function(w){ return !w.prisoner; });
  if (wilds.length && rnd < 0.55){
    var w = wilds[Math.floor(Math.random()*wilds.length)];
    w.wild = false; w.fac = g.fac; w.acted = true; w.soldiers = Math.max(w.soldiers, 200);
    pushLog(st, "good", f.lord + "方：" + g.name + " 在 " + c.name + " 访得在野武将 " + w.name + "（武" + w.wu + "/智" + w.zhi + "），已加入麾下！");
    return {ok:true, msg:"搜索发现 " + w.name + " 并加入我方！"};
  }
  if (rnd < 0.78){
    var gold = 150 + Math.floor(Math.random()*350);
    f.gold += gold;
    pushLog(st, "", f.lord + "方：" + g.name + " 在 " + c.name + " 搜得民间藏金 " + gold + "。");
    return {ok:true, msg:"搜得金钱 " + gold};
  }
  if (rnd < 0.88){
    var items = [["青釭剑",{wu:5}],["兵法二十四篇",{zhi:5}],["爪黄飞电",{wu:3}],["孙子兵法",{zhi:4}],["铜雀",{wu:2,zhi:2}]];
    var it = items[Math.floor(Math.random()*items.length)];
    if (g.item){ f.gold += 120; return {ok:true, msg:g.name + " 找到宝物" + it[0] + "，但已有装备，折金 120"}; }
    g.item = it[0];
    if (it[1].wu) g.wu = Math.min(105, g.wu + it[1].wu);
    if (it[1].zhi) g.zhi = Math.min(105, g.zhi + it[1].zhi);
    g.maxmp = 30 + Math.round(g.zhi/2);
    pushLog(st, "good", f.lord + "方：" + g.name + " 在 " + c.name + " 寻得宝物【" + it[0] + "】并装备！");
    return {ok:true, msg:g.name + " 获得宝物【" + it[0] + "】"};
  }
  pushLog(st, "", f.lord + "方：" + g.name + " 在 " + c.name + " 搜索一番，一无所获。");
  return {ok:true, msg:"搜索无果"};
}
function actRecruit(st, g){
  var f = F(st, g.fac), c = st.cities[g.city];
  var cap = soldierCap(g), room = cap - g.soldiers;
  if (room <= 0) return {ok:false, msg:g.name + " 已满编（" + cap + "）"};
  var want = Math.min(room, Math.floor(c.pop*0.06), Math.floor(f.gold/0.4));
  if (want < 50) return {ok:false, msg:"金钱或人口不足，无法征兵"};
  want = Math.floor(want/10)*10;
  var cost = Math.ceil(want*0.4);
  f.gold -= cost; c.pop -= Math.round(want/2);
  var oldTrain = g.train * g.soldiers;
  g.soldiers += want;
  g.train = Math.max(20, Math.round((oldTrain + want*30)/g.soldiers));
  g.acted = true;
  pushLog(st, "", f.lord + "方：" + g.name + " 在 " + c.name + " 征兵 " + want + "（耗金 " + cost + "），现领兵 " + g.soldiers + "，新兵训练度偏低。");
  return {ok:true, msg:g.name + " 征兵 +" + want + "，现 " + g.soldiers + " 人"};
}
function actTrain(st, g){
  var f = F(st, g.fac);
  if (f.gold < 30) return {ok:false, msg:"金钱不足（需 30）"};
  if (g.train >= 100) return {ok:false, msg:"训练度已满"};
  f.gold -= 30;
  var gain = 12 + Math.round(g.wu/8);
  g.train = Math.min(100, g.train + gain);
  g.acted = true;
  pushLog(st, "", f.lord + "方：" + g.name + " 在 " + g.city + " 操练兵马，训练度升至 " + g.train + "。");
  return {ok:true, msg:g.name + " 训练度 → " + g.train};
}
function actMove(st, g, target){
  if (st.cities[target].owner !== g.fac) return {ok:false, msg:"只能移动到己方城池"};
  if (target === g.city) return {ok:false, msg:"已在该城"};
  var from = g.city;
  g.city = target; g.acted = true;
  pushLog(st, "", F(st,g.fac).lord + "方：" + g.name + " 率军自 " + from + " 移驻 " + target + "。");
  return {ok:true, msg:g.name + " 已移驻 " + target};
}
/* 招降俘虏：每势力每季一次；俘虏须在上一季之前被俘 */
function actRecruitPrisoner(st, fid, pname){
  var f = F(st, fid), g = st.generals[pname];
  if (!g || !g.prisoner || g.heldBy!==fid) return {ok:false, msg:"俘虏不存在"};
  if (f.recruited) return {ok:false, msg:"本季已招降过一次"};
  if (g.prisonSeason >= st.year*4 + st.season) return {ok:false, msg:"新俘之将需待下季方可招降"};
  f.recruited = true;
  var p = 0.62 - g.loyal/260 + (st.generals[f.lord].zhi >= 85 ? 0.08 : 0);
  p = Math.max(0.12, Math.min(0.9, p));
  if (Math.random() < p){
    var cap = lordCity(st, fid);
    g.prisoner = false; g.heldBy = null; g.wild = false; g.fac = fid;
    g.city = cap; g.loyal = Math.max(45, g.loyal - 25); g.acted = true; g.hp = Math.round(g.maxhp*0.7);
    pushLog(st, "good", "【招降】" + f.lord + " 成功招降俘虏 " + g.name + "，其已归顺并驻 " + cap + "。");
    return {ok:true, msg:"招降成功！" + g.name + " 归顺我方"};
  }
  if (Math.random() < 0.25){
    var escCity = g.city || lordCity(st, fid);
    g.prisoner = false; g.heldBy = null; g.wild = true; g.fac = null; g.city = escCity; g.soldiers = Math.max(80, Math.round(g.soldiers*0.3));
    pushLog(st, "war", "【逃脱】俘虏 " + g.name + " 拒绝招降并趁夜逃走，现下落于 " + escCity + " 一带（在野）。");
    return {ok:true, msg:g.name + " 拒绝招降并逃走了"};
  }
  pushLog(st, "", "【招降失败】" + f.lord + " 招降 " + g.name + " 未果，其仍被关押。");
  return {ok:true, msg:"招降失败，" + g.name + " 仍拒降"};
}

